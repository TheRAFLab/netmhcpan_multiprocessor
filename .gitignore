# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the
#   code is intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in
#   version control. However, in case of collaboration, if having
#   platform-specific dependencies or dependencies having no cross-platform
#   support, pipenv may install dependencies that don't work, or not install
#   all needed dependencies.
# Pipfile.lock

# UV
#   uv.lock is deliberately NOT ignored here. It pins the exact dependency
#   versions this package was tested against, which is what makes `uv sync`
#   reproduce a working environment on someone else's machine.
# uv.lock

# poetry
# poetry.lock
# poetry.toml

# pdm
# pdm.lock
.pdm.toml
.pdm-python
.pdm-build/

# PEP 582
__pypackages__/

